{
  "name": "afmpt-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AF Master Project Tracker — collaborative mind-map PM tool for SmartOSC AF team",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "p1:directory": "node scripts/p1-build-directory.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,html}\"",
    "migrate": "node scripts/migrate.js",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-afmpt \"vitest run --config vitest.rules.config.js\"",
    "p1:dryrun": "node scripts/p1-identity-dryrun.mjs",
    "p2:dryrun": "node scripts/p2-migrate-dryrun.mjs"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "firebase-admin": "^12.0.0",
    "firebase-tools": "14.27.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "2.1.9"
  }
}
