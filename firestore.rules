rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// AF·MTP Tracker security rules
//
// Two layers of access control:
//   1. Domain gate: only verified @smartosc.com Workspace identities pass
//   2. Per-project RBAC: each project has memberIds[] + roles{uid: 'owner'|'operator'|'member'}
//      - owner   : full control (rename, delete, manage members, edit content)
//      - operator: edit content (programs/workstreams/tasks/check-ins)
//      - member  : read-only
//
// Activity log entries are validated server-side: the `author` field MUST equal
// the caller's verified email (no spoofing teammates' identities).
//
// IMPORTANT — migration order: any project that lacks `memberIds` will be
// invisible to clients (the where('memberIds', 'array-contains', uid) query
// can't match it, and Firestore rejects unconstrained list queries that could
// return unauthorized docs). Before publishing these rules to a workspace
// that has v1 data, run scripts/setup-rbac.js with admin credentials so every
// existing project gets memberIds/roles populated.
//
// Deploy: firebase deploy --only firestore:rules --project <prod project id>
// (or paste in Firebase Console → Firestore Database → Rules) — only after CI is green.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function isSmartOSC() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@smartosc[.]com$');
    }

    function projectData(pid) {
      return get(/databases/$(database)/documents/workspaces/main/projects/$(pid)).data;
    }

    function isMember(p) {
      return ('memberIds' in p) && (request.auth.uid in p.memberIds);
    }

    function roleOf(p, uid) {
      return ('roles' in p && uid in p.roles) ? p.roles[uid] : null;
    }

    function canEdit(p) {
      return roleOf(p, request.auth.uid) == 'owner'
          || roleOf(p, request.auth.uid) == 'operator';
    }

    function isOwner(p) {
      return roleOf(p, request.auth.uid) == 'owner';
    }

    function hasAtLeastOneOwner(p) {
      return p.roles.values().hasAny(['owner']);
    }

    // ─────── Workspace meta ───────
    // B1 (2026-10-14): owner fields are owner-only. Any domain user may still
    // write the rest of the doc (userPreferences, seeded, updatedAt…) because
    // saveMeta() sends the whole meta object with merge:true; unchanged keys
    // are not "affected" so stale-but-identical owner fields pass.
    // There is no client-side claim or release: ownerless recovery is an
    // admin-script operation (see CLAUDE.md Rollback).
    // P2.1 (2026-10-23): ownerUids[] (set by scripts/p2-set-owner-uids.mjs) is
    // owner-only like the other owner fields; the client never writes it.
    function ownerFields() {
      return ['workspaceOwner', 'ownershipLog', 'defaultView', 'ownerUids'];
    }

    // Owner = uid in ownerUids[] OR the legacy workspaceOwner email (kept until
    // P2.5 so a missing/empty ownerUids never locks the Owner out).
    // Used by isWorkspaceOwner() (workspace doc) and isDirectoryOwner()
    // (members/invites, via get()); keep the two call sites in sync.
    function isOwnerIn(ws) {
      return (ws.get('ownerUids', []) is list && request.auth.uid in ws.get('ownerUids', []))
        || (ws.get('workspaceOwner', null) is string
          && ws.workspaceOwner.lower() == request.auth.token.email.lower());
    }

    function isWorkspaceOwner() {
      return isOwnerIn(resource.data);
    }

    function newOwnerIsValid() {
      return request.resource.data.get('workspaceOwner', null) is string
        && request.resource.data.workspaceOwner.lower().matches('.*@smartosc[.]com$');
    }

    // ownerUids, when written, must stay a non-empty list (no removal, no []).
    function newOwnerUidsAreValid() {
      return request.resource.data.get('ownerUids', null) is list
        && request.resource.data.ownerUids.size() > 0;
    }

    // Owner write: each owner field that changes must stay valid. Fields that
    // are not affected are not re-checked, so an owner can change only
    // ownerUids (or defaultView) without touching workspaceOwner.
    function ownerWriteIsValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['workspaceOwner']) || newOwnerIsValid())
        && (!changed.hasAny(['ownerUids']) || newOwnerUidsAreValid());
    }

    match /workspaces/{workspace} {
      allow read: if isSmartOSC() && workspace == 'main';

      allow create: if isSmartOSC() && workspace == 'main'
        && !request.resource.data.keys().hasAny(ownerFields());

      allow update: if isSmartOSC() && workspace == 'main' && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(ownerFields())
        || (isWorkspaceOwner() && ownerWriteIsValid())
      );

      allow delete: if false;
    }

    // ─────── People directory: members / invites ───────
    // P1 (2026-10-22), Q4: Owner-managed. members/{uid} = signed-in people,
    // invites/{email} = not yet signed in (doc id = lower-cased email).
    // Any domain user may read. Only the Workspace Owner may write, except one
    // self-claim: a signed-in user may create their own members/{uid} as an
    // exact copy of their invite (status 'active', audit fields = caller/now).
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // Same check as isWorkspaceOwner() (isOwnerIn) via get(); keep in sync.
    // The legacy email branch is dropped from isOwnerIn() in P2.5.
    function isDirectoryOwner() {
      return isOwnerIn(get(/databases/$(database)/documents/workspaces/main).data);
    }

    function invitePath() {
      return /databases/$(database)/documents/workspaces/main/invites/$(callerEmail());
    }

    function isValidSelfClaim(uid) {
      return uid == request.auth.uid
        && exists(invitePath())
        && claimMatchesInvite(request.resource.data, get(invitePath()).data);
    }

    function claimMatchesInvite(d, inv) {
      return d.keys().hasOnly(['email', 'displayName', 'aliases', 'department', 'status', 'updatedAt', 'updatedBy'])
        && d.get('email', null) == inv.get('email', null)
        && d.get('displayName', null) == inv.get('displayName', null)
        && d.get('aliases', null) == inv.get('aliases', null)
        && d.get('department', null) == inv.get('department', null)
        && inv.get('status', null) == 'active'
        && d.get('status', null) == 'active'
        && d.get('updatedBy', null) == callerEmail()
        && d.get('updatedAt', null) == request.time;
    }

    match /workspaces/main/members/{uid} {
      allow read: if isSmartOSC();
      allow create: if isSmartOSC() && (isDirectoryOwner() || isValidSelfClaim(uid));
      allow update, delete: if isSmartOSC() && isDirectoryOwner();
    }

    match /workspaces/main/invites/{email} {
      allow read: if isSmartOSC();
      allow write: if isSmartOSC() && isDirectoryOwner();
    }

    // ─────── Projects ───────
    // Per-doc read rule: members (memberIds), plus canReadProject for
    // schemaVersion 2 docs (Ruling V, below). Firestore enforces this on get()
    // and on list() — but list queries must constrain themselves so Firestore
    // can prove all returned docs match. The client lists with
    //     query(projects, where('memberIds', 'array-contains', uid))
    // which passes on the memberIds branch.
    // P2.2 gate (2026-10-23): v2 project fields are workspace-Owner-only
    // (Owner = isOwnerIn(workspaces/main) via isDirectoryOwner(), NOT the v1
    // per-project 'owner' role). Added on top of the v1 rule, never instead.
    function ownerOnlyProjectKeys() {
      return ['programMeta', 'memberUids', 'visibility', 'schemaVersion'];
    }

    // Update gate. A doc with schemaVersion 2 is frozen for non-Owners (v2
    // writes go to sub-collections; an old cached bundle must not rewrite
    // the v1 arrays that rollback relies on). Otherwise a non-Owner may not
    // affect the owner-only keys (unchanged keys are not affected, so a
    // full-doc save that preserves them passes).
    // get(): workspaces/main = 1, only when the cheap checks fail.
    function projectGateOk() {
      return (resource.data.get('schemaVersion', 1) != 2
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(ownerOnlyProjectKeys()))
        || isDirectoryOwner();
    }

    match /workspaces/main/projects/{pid} {

      // P2.3 Ruling V: a schemaVersion 2 doc is also readable per
      // canReadProject (Owner, memberUids, department visibility for active
      // members). v1 docs unchanged. The memberIds list query still passes
      // on the first branch. get(): v2 branch = workspace, members/{me},
      // project = 3.
      allow read: if isSmartOSC() && (
        isMember(resource.data)
        || (resource.data.get('schemaVersion', 1) == 2 && canReadProject('main', pid))
      );

      // CREATE — creator must put themselves as owner; required fields enforced.
      // A non-Owner create may not carry the owner-only v2 keys (get(): 1).
      allow create: if isSmartOSC()
        && request.resource.data.keys().hasAll(['name', 'memberIds', 'roles'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && (!request.resource.data.keys().hasAny(ownerOnlyProjectKeys()) || isDirectoryOwner());

      // UPDATE — owners can change anything (must keep at least one owner).
      // Operators can change content but not membership/roles, name,
      // deletedAt, or createdBy.
      // P2.3 Ruling P: a schemaVersion 2 doc may be updated by the workspace
      // Owner regardless of per-project roles (any value, including
      // schemaVersion 1 for rollback). Non-Owners stay denied on v2 docs
      // via projectGateOk(). get(): workspaces/main = 1.
      allow update: if isSmartOSC() && (
        ((
          // Owner: full update
          (isOwner(resource.data)
            && hasAtLeastOneOwner(request.resource.data))
          ||
          // Operator: cannot touch ACL / name / deletedAt / createdBy
          (canEdit(resource.data)
            && request.resource.data.roles == resource.data.roles
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.name == resource.data.name
            && request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null)
            && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null))
        ) && projectGateOk())
        || (resource.data.get('schemaVersion', 1) == 2 && isDirectoryOwner())
      );

      // DELETE (hard). v1 doc: per-project owners (soft delete via
      // update(deletedAt) preferred). P2.3: a schemaVersion 2 doc may be
      // deleted only by the workspace Owner. get(): workspaces/main = 1.
      allow delete: if isSmartOSC() && (
        (resource.data.get('schemaVersion', 1) != 2 && isOwner(resource.data))
        || (resource.data.get('schemaVersion', 1) == 2 && isDirectoryOwner())
      );
    }

    // ─────── Activity log ───────
    // Entries are an array on a single doc. Author is validated server-side
    // against the caller's verified email — teammates can't spoof each other.
    // Cap of 500 enforced; older entries stay immutable except for the trim tail.
    match /workspaces/main/activity/{pid} {
      allow read: if isSmartOSC() && isMember(projectData(pid));

      // First write (no existing doc): must contain at least one entry by current user.
      allow create: if isSmartOSC()
        && isMember(projectData(pid))
        && request.resource.data.entries.size() > 0
        && request.resource.data.entries.size() <= 500
        && request.resource.data.entries[0].author == request.auth.token.email;

      // Subsequent writes: entries[0] must be a new entry by the current user;
      // size capped at 500. (We can't easily verify older entries are unchanged
      // without per-entry inspection, but `author` spoofing of NEW entries is blocked.)
      allow update: if isSmartOSC()
        && isMember(projectData(pid))
        && request.resource.data.entries.size() <= 500
        && request.resource.data.entries[0].author == request.auth.token.email;

      // No deletes; activity is append-only.
      allow delete: if false;
    }

    // ═══════ v2 sub-collections (P2.1, 2026-10-23) ═══════
    // Additive: these paths are not used by the client until P2.4 (switch).
    // Nothing above changes behaviour. Role matrix: spec §4 (P2 scope; the
    // approval flow / 'Submitted' status arrives in P3).
    //   Owner    = isOwnerIn(workspaces/{wid})  (ownerUids OR legacy email)
    //   PM       = project.programMeta[programId].pmUid / deputyUid
    //   Sub-PM   = workstreams/{wsId}.leadUid (null/absent/'' => nobody)
    //   Assignee = task.picUid / action.picUid
    //   Viewer   = canReadProject (restricted: memberUids; department: any active member)
    // Contributors (task.contributorUids, HOD decision 23/10, P2.2): may only
    // append task updates (keys updates/updatedAt/updatedBy/version).
    // Every non-Owner writer must also be an active member (deactivated
    // people keep their pmUid/leadUid/picUid but lose write access).
    // wid always comes from the match path (no hard-coded 'main').
    //
    // get()/exists() budget (Ruling E, limit 10; same-path calls are counted
    // per distinct document): workspace doc, members/{me}, project doc, and
    // up to 2 workstream docs => at most 5 per evaluation.

    function v2Workspace(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)).data;
    }

    function v2MemberPath(wid) {
      return /databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid);
    }

    function v2Project(wid, pid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)).data;
    }

    function v2WsPath(wid, pid, wsId) {
      return /databases/$(database)/documents/workspaces/$(wid)/projects/$(pid)/workstreams/$(wsId);
    }

    function v2WsData(wid, pid, wsId) {
      return get(v2WsPath(wid, pid, wsId)).data;
    }

    // Named isWsOwner (not isOwner) because isOwner(p) is the v1 project role.
    function isWsOwner(wid) {
      return isOwnerIn(v2Workspace(wid));
    }

    function isActiveMember(wid) {
      return isSmartOSC()
        && exists(v2MemberPath(wid))
        && get(v2MemberPath(wid)).data.get('status', null) == 'active';
    }

    function isPMIn(p, prg) {
      return prg is string
        && (p.get('programMeta', {}).get(prg, {}).get('pmUid', null) == request.auth.uid
          || p.get('programMeta', {}).get(prg, {}).get('deputyUid', null) == request.auth.uid);
    }

    function isPM(wid, pid, prg) {
      return isActiveMember(wid) && isPMIn(v2Project(wid, pid), prg);
    }

    function wsExists(wid, pid, wsId) {
      return wsId is string && exists(v2WsPath(wid, pid, wsId));
    }

    // Empty leadUid (null / absent / '') means no Sub-PM. The WS's program
    // must exist in programMeta (a legacy project without programMeta has no
    // Sub-PM rights, same as no PM rights).
    function isLead(wid, pid, wsId) {
      return isActiveMember(wid)
        && wsExists(wid, pid, wsId)
        && v2WsData(wid, pid, wsId).get('leadUid', null) == request.auth.uid
        && v2WsData(wid, pid, wsId).get('programId', null) is string
        && v2WsData(wid, pid, wsId).programId in v2Project(wid, pid).get('programMeta', {});
    }

    // The workstream exists and belongs to program prg.
    function wsInProgram(wid, pid, wsId, prg) {
      return prg is string
        && wsExists(wid, pid, wsId)
        && v2WsData(wid, pid, wsId).get('programId', null) == prg;
    }

    // Dates are ISO 'yyyy-mm-dd' strings or null; compared as strings.
    // Null WS bound = no limit; null task date passes.
    function withinWs(t, w) {
      return (t.get('start', null) == null || w.get('start', null) == null || t.start >= w.start)
        && (t.get('end', null) == null || w.get('end', null) == null || t.end <= w.end);
    }

    // Affected keys of an update. Computed ONCE per update rule (via let in
    // the *UpdateOk function) and passed down as `ch`: re-running diff() in
    // every helper hit the 1000-expression evaluation limit (CI, 8447d8e).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Written doc must name the path's workspace and project (anti-spoof).
    function pathFieldsOk(wid, pid) {
      return request.resource.data.get('workspaceId', null) == wid
        && request.resource.data.get('projectId', null) == pid;
    }

    // Optimistic concurrency, enforced server-side: create => version 1,
    // every update => previous version + 1 (absent previous = 0).
    function versionOnCreate() {
      return request.resource.data.get('version', null) == 1;
    }

    function versionBumped() {
      return request.resource.data.get('version', null) == resource.data.get('version', 0) + 1;
    }

    // Ruling I: every create/update of a task, action or workstream stamps
    // the writer (Owner included). Not "if affected": an unchanged stale
    // updatedBy would attribute the edit to the previous writer.
    function stampedByMe() {
      return request.resource.data.get('updatedBy', null) == request.auth.uid;
    }

    // Ruling Z (P2.3): list field k of d, a missing OR null value read as []
    // (migrated docs may hold updates: null).
    function listOrEmpty(d, k) {
      return d.get(k, null) == null ? [] : d.get(k, null);
    }

    // List field k is append-only (missing = []). App.jsx PREPENDS new
    // entries (newest first: `updates: [newU, ...old]`), so the old items
    // must stay as the SUFFIX and at most one entry is added per write
    // (P2.3; P2.1 checked a prefix, which never matched real data).
    // Only evaluated when k is affected. An empty slice is an
    // index-out-of-bound error in the rules runtime, so an empty old list
    // short-circuits before slicing. The new entry's authorUid is checked
    // by newEntryOk (all writers).
    // P3 review round 1: o / n are passed as arguments (evaluated once,
    // expression limit) instead of let-bound.
    function appendOnly(ch, k) {
      return !ch.hasAny([k])
        || appendOnlyWith(listOrEmpty(resource.data, k), listOrEmpty(request.resource.data, k));
    }

    function appendOnlyWith(o, n) {
      return o is list && n is list
        && (n == o
          || (n.size() == o.size() + 1
            && (o.size() == 0 || n[1:n.size()] == o)));
    }

    // Ruling R (P2.3), all writers incl. Owner: a write may add at most one
    // entry to list k, and an added entry (index 0, App prepends) must carry
    // authorUid == caller. Same size or shrinking (Owner / PM / Sub-PM
    // editing history) is not checked here. Rules cannot loop, so nested
    // lists (RAID items[].history[], mitigation comments[]) are not checked.
    function newEntryOk(ch, k) {
      return !ch.hasAny([k])
        || newEntryWith(listOrEmpty(resource.data, k), listOrEmpty(request.resource.data, k));
    }

    function newEntryWith(o, n) {
      return o is list && n is list
        && (n.size() <= o.size()
          || (n.size() == o.size() + 1
            && n[0].get('authorUid', null) == request.auth.uid));
    }

    // Restricted (default when visibility is absent): Owner + memberUids.
    // Department: any active member. While memberUids is absent (pre-P2.4)
    // fall back to the v1 memberIds list.
    // get(): workspace, members/{me}, project = 3.
    function canReadProject(wid, pid) {
      let p = v2Project(wid, pid);
      return isSmartOSC() && (
        isWsOwner(wid)
        || (isActiveMember(wid) && (
          p.get('visibility', 'restricted') == 'department'
          || (p.get('memberUids', null) is list
            ? request.auth.uid in p.memberUids
            : (p.get('memberIds', null) is list && request.auth.uid in p.memberIds))))
      );
    }

    // P2.4 rollback (fix round 1): v2 sub-docs only live while the parent
    // project doc has schemaVersion 2. After a rollback (schemaVersion back to
    // 1/absent) every client read, create, update and delete on workstreams,
    // tasks, actions, raid, decisions and activity is denied, so a stale v2
    // tab cannot write data nobody reads. Admin scripts bypass rules.
    // get(): the project doc, the same one canReadProject / v2Project /
    // isPM / raidWriterOk read (counted once per distinct doc), so it adds a
    // get() only on paths that did not read the project before (Owner-only
    // branches: +1).
    function projectIsV2(wid, pid) {
      return v2Project(wid, pid).get('schemaVersion', 1) == 2;
    }

    // ─────── v2: workstreams ───────
    // Create/delete and set leadUid: Owner or PM of the program. Sub-PM has
    // no workstream writes in P2. WS dates (start/end) and moving a WS to
    // another program are Owner-only (matrix: PM must request -> Owner), so a
    // PM-created WS must have null start/end.
    // version: create = 1, update = +1; updatedBy = caller uid on every write.
    // get(): workspace, members/{me}, project = 3 (read: 3); P2.4 projectIsV2
    // reuses the project get (Owner-only create/update/delete: 2).
    function wsUpdateOk(wid, pid) {
      let ch = changedKeys();
      return isWsOwner(wid)
        || (!ch.hasAny(['programId', 'start', 'end'])
          && isPM(wid, pid, resource.data.get('programId', null)));
    }

    match /workspaces/{wid}/projects/{pid}/workstreams/{wsId} {
      // get(): 3 (project shared with canReadProject).
      allow read: if projectIsV2(wid, pid) && canReadProject(wid, pid);

      // get(): Owner 2, PM 3.
      allow create: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionOnCreate() && stampedByMe() && (
        isWsOwner(wid)
        || (isPM(wid, pid, request.resource.data.get('programId', null))
          && request.resource.data.get('start', null) == null
          && request.resource.data.get('end', null) == null)
      );

      // get(): Owner 2, PM 3.
      allow update: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionBumped() && stampedByMe() && wsUpdateOk(wid, pid);

      // get(): Owner 2, PM 3.
      allow delete: if isSmartOSC() && projectIsV2(wid, pid) && (
        isWsOwner(wid)
        || isPM(wid, pid, resource.data.get('programId', null))
      );
    }

    // ─────── v2: tasks ───────
    // Create: Owner (unlimited); PM of the program or Sub-PM of the WS - the
    //   WS must belong to the program and the task must be within WS dates.
    // Update: Owner (unlimited); PM of the task's program (moving to another
    //   WS/program requires PM of the target program too, and a consistent
    //   WS); Sub-PM of the task's WS (no move). For PM and Sub-PM the WS date
    //   check (against the NEW ws) applies only when start/end/workstreamId
    //   change, so status/health edits on a migrated out-of-range task work.
    //   Assignee (picUid == me): only progress keys + the close request keys;
    //   status must be present; only while the task is Planned / InProgress
    //   / Submitted; updates/checkIns are append-only for the Assignee.
    //   Contributor (P2.2): append-only updates, see taskContributorUpdate.
    // P3 close transitions (Rulings P3-1, P3-3, P3-4, P3-6, P3-7, P3-18):
    //   status / closeRequest / closeRequestHistory / approvedByUid /
    //   approvedAt / closedByUid change only through closeTransitionOk
    //   (Assignee, PM and Sub-PM branches): open moves, submit, withdraw,
    //   approve, reject (with reason), reassign (PM; Owner unrestricted),
    //   direct close by a manager who is not the PIC, reopen (manager).
    //   No self-credit (review round 1): a non-Owner manager may change
    //   picUid only while the task is open; a direct close keeps picUid and
    //   is denied to a manager in contributorUids (Ruling P3-C2); reopen
    //   clears approvedByUid / approvedAt / closedByUid.
    //   Nobody decides their own request. Every write that sets status to
    //   Completed / Dropped carries approvedByUid == caller (closeStampOk,
    //   Owner included). A non-Owner creates tasks Planned / InProgress only.
    // All writers: version create = 1 / update = +1; updatedBy must equal
    //   the caller uid on every write (Ruling I); an entry added to updates
    //   or checkIns (at most one per write) carries authorUid == caller
    //   (Ruling R, P2.3, newEntryOk - Owner included). Not checked on create.
    // Delete: workspace Owner only (Ruling AF; others set Dropped instead).
    // Owner writes skip the WS checks (avoids batch-ordering issues in P2.4).
    // get(): create = workspace, members/{me}, project, ws = 4;
    //        update = workspace, members/{me}, project, old ws, new ws = 5;
    //        delete = 1; read = 3.
    // P2.4 projectIsV2 reuses the project get: delete = 2, Owner-only
    // create/update = 2; the others unchanged.
    // P3: eligibleApprover / canDecide read only the workspace, the project
    // and the task's OLD ws (and members via isPM), all already in the
    // budget above: update stays <= 5 (Assignee 4: workspace, project,
    // members/{me}, old ws).
    // Ruling AE (P2.3): + references and the deadline request flow
    // (deadlineRequest, deadlineRequestHistory). The due date itself (end)
    // stays out: it changes only when an approver applies the request.
    function assigneeKeys() {
      return ['status', 'health', 'healthNote', 'updates', 'checkIns',
        'references', 'deadlineRequest', 'deadlineRequestHistory',
        'updatedAt', 'updatedBy', 'version'];
    }

    // The new task data is within its (new) WS's dates.
    function taskWithinNewWs(wid, pid) {
      let n = request.resource.data;
      return wsExists(wid, pid, n.get('workstreamId', null))
        && withinWs(n, v2WsData(wid, pid, n.workstreamId));
    }

    function taskDatesOk(wid, pid, ch) {
      return !ch.hasAny(['start', 'end', 'workstreamId']) || taskWithinNewWs(wid, pid);
    }

    // PM of the task's program (pm, computed once by the caller): may move
    // the task to a WS of a program they are PM of too. p = project data.
    function taskPMMoveOk(wid, pid, ch, p) {
      return !ch.hasAny(['programId', 'workstreamId'])
        || (isPMIn(p, request.resource.data.get('programId', null))
          && wsInProgram(wid, pid, request.resource.data.get('workstreamId', null),
                         request.resource.data.get('programId', null)));
    }

    // Sub-PM of the task's WS (same test as isLead, with the caller's
    // active-member check and the project data already done / passed in).
    function leadOfWs(w, p) {
      return w.get('leadUid', null) == request.auth.uid
        && w.get('programId', null) is string
        && w.programId in p.get('programMeta', {});
    }

    function taskLeadOk(wid, pid, ch, p) {
      return !ch.hasAny(['programId', 'workstreamId'])
        && wsExists(wid, pid, resource.data.get('workstreamId', null))
        && leadOfWs(v2WsData(wid, pid, resource.data.workstreamId), p);
    }

    // ── P3 close transitions ──
    // o = resource.data, n = request.resource.data, me = request.auth.uid,
    // s0 / s1 = old / new status read with get('status', 'Planned').
    function closeKeys() {
      return ['status', 'closeRequest', 'closeRequestHistory', 'approvedByUid', 'approvedAt', 'closedByUid'];
    }

    function isClosedSt(s) {
      return s in ['Completed', 'Dropped'];
    }

    function isOpenSt(s) {
      return s in ['Planned', 'InProgress'];
    }

    // programMeta entry of program prg ({} when prg is not a string / absent).
    function prgMetaOf(p, prg) {
      return prg is string ? p.get('programMeta', {}).get(prg, {}) : {};
    }

    function isPMOrDeputyUid(m, u) {
      return u == m.get('pmUid', null) || u == m.get('deputyUid', null);
    }

    // Mirror of eligibleApprovers (client, P3 Task 6). Approver a of a
    // request by `requester` on task d: never the requester; any Owner
    // (ownerUids only, Ruling P3-20); the PM / Deputy of d's program, or the
    // Sub-PM of d's WS, unless the requester is that PM / Deputy.
    // get(): workspace, project, ws of d (all already counted).
    // Expression limit (1000): computed values are passed as arguments
    // (evaluated once) rather than re-derived in each helper.
    function eligibleApprover(wid, pid, d, a, requester) {
      return a is string && a != requester
        && eligibleWith(wid, pid, d, a, requester,
          prgMetaOf(v2Project(wid, pid), d.get('programId', null)));
    }

    function inList(l, a) {
      return l is list && a in l;
    }

    function eligibleWith(wid, pid, d, a, requester, m) {
      return inList(v2Workspace(wid).get('ownerUids', []), a)
        || (!isPMOrDeputyUid(m, requester)
          && (isPMOrDeputyUid(m, a)
            || (wsExists(wid, pid, d.get('workstreamId', null))
              && v2WsData(wid, pid, d.workstreamId).get('leadUid', null) == a)));
    }

    // Ruling P3-4: who may decide request cr on task d (never the requester).
    // The Owner never reaches this (Owner branch first). pm = caller is
    // PM/Deputy of the task's program and m = that program's programMeta
    // entry (both computed once by the caller).
    function canDecide(cr, pm, m) {
      return cr.get('requestedByUid', null) != request.auth.uid
        && (cr.get('approverUid', null) == request.auth.uid
          || (pm && !isPMOrDeputyUid(m, cr.get('requestedByUid', null))));
    }

    // One decision entry prepended to closeRequestHistory (old entries kept
    // as the suffix, exactly one added), status st, decided by me. Same
    // test as appendOnly + "grows by 1" without re-deriving the diff.
    function histOk(st) {
      return histWith(st, listOrEmpty(resource.data, 'closeRequestHistory'),
                      listOrEmpty(request.resource.data, 'closeRequestHistory'));
    }

    function histWith(st, o, n) {
      return o is list && n is list
        && n.size() == o.size() + 1
        && (o.size() == 0 || n[1:n.size()] == o)
        && n[0] is map
        && n[0].get('status', null) == st
        && n[0].get('decidedByUid', null) == request.auth.uid;
    }

    function reasonOk(e) {
      return e.get('reason', null) is string && e.reason.size() > 0;
    }

    // submit: c = the new closeRequest.
    function closeSubmitOk(wid, pid, ch, mgr, c) {
      return c is map
        && c.get('requestedByUid', null) == request.auth.uid
        && c.get('outcome', null) in ['Completed', 'Dropped']
        && (resource.data.get('picUid', null) == request.auth.uid || mgr)
        && !ch.hasAny(['closeRequestHistory', 'approvedByUid', 'approvedAt', 'closedByUid'])
        && eligibleApprover(wid, pid, resource.data, c.get('approverUid', null), request.auth.uid);
    }

    // From Planned / InProgress: open move, submit, or (manager, Ruling
    // P3-3) a direct close of a task they are not PIC of, stamped. No
    // self-credit (review round 1, Ruling P3-C2): the direct close may not
    // change picUid, and a manager listed in contributorUids must submit
    // like anyone else. It never touches the close request / history.
    function closeFromOpen(wid, pid, ch, s1, mgr) {
      return (isOpenSt(s1)
          && !ch.hasAny(['closeRequest', 'closeRequestHistory', 'approvedByUid', 'approvedAt', 'closedByUid']))
        || (s1 == 'Submitted'
          && closeSubmitOk(wid, pid, ch, mgr, request.resource.data.get('closeRequest', null)))
        || (mgr && isClosedSt(s1)
          && resource.data.get('picUid', null) != request.auth.uid
          && !ch.hasAny(['picUid', 'closeRequest', 'closeRequestHistory'])
          && !inList(request.resource.data.get('contributorUids', null), request.auth.uid)
          && request.resource.data.get('approvedByUid', null) == request.auth.uid);
    }

    // From Submitted (c0 = old request, c1 = new request):
    //   withdraw (requester, -> open), approve (status == outcome, stamped),
    //   reject (-> InProgress, reason), reassign (PM; approverUid only).
    // pm = caller is PM/Deputy of the task's program; m = its programMeta.
    function closeFromSubmitted(wid, pid, s1, c0, c1, pm, m) {
      return c0 is map && (
        (isOpenSt(s1) && c1 == null
          && c0.get('requestedByUid', null) == request.auth.uid
          && histOk('Withdrawn'))
        || (isClosedSt(s1) && c1 == null
          && s1 == c0.get('outcome', null)
          && request.resource.data.get('approvedByUid', null) == request.auth.uid
          && histOk('Approved')
          && canDecide(c0, pm, m))
        || (s1 == 'InProgress' && c1 == null
          && histOk('Rejected')
          && reasonOk(request.resource.data.closeRequestHistory[0])
          && canDecide(c0, pm, m))
        || (pm && s1 == 'Submitted' && c1 is map
          && c1.diff(c0).affectedKeys().hasOnly(['approverUid'])
          && histOk('Reassigned')
          && eligibleApprover(wid, pid, resource.data, c1.get('approverUid', null),
                              c0.get('requestedByUid', null)))
      );
    }

    // Only called when a close key changed (callers branch on cl first, so
    // ordinary P2.3 edits never evaluate the P3 helpers).
    // mgr = the caller passed the PM or Sub-PM branch for this task.
    // reopen (manager): closed -> open, close request keys untouched, the
    // approval stamp cleared (approvedByUid / approvedAt / closedByUid null
    // or absent).
    function closeTransitionOk(wid, pid, ch, s0, s1, mgr, pm, m) {
      return (isOpenSt(s0) && closeFromOpen(wid, pid, ch, s1, mgr))
        || (s0 == 'Submitted'
          && closeFromSubmitted(wid, pid, s1, resource.data.get('closeRequest', null),
                                request.resource.data.get('closeRequest', null), pm, m))
        || (mgr && isClosedSt(s0) && isOpenSt(s1)
          && !ch.hasAny(['closeRequest', 'closeRequestHistory'])
          && request.resource.data.get('approvedByUid', null) == null
          && request.resource.data.get('approvedAt', null) == null
          && request.resource.data.get('closedByUid', null) == null);
    }

    // Ruling P3-18, all writers incl. Owner: setting Completed / Dropped
    // stamps approvedByUid == caller.
    function closeStampOk(ch, s1) {
      return !(ch.hasAny(['status']) && isClosedSt(s1))
        || request.resource.data.get('approvedByUid', null) == request.auth.uid;
    }

    // Cheap checks first (picUid, keys, status) before the members get.
    // status must stay present (V2-30). blockerResolutions: checks in P3
    // Task 3 (Ruling P3-8). cl = a close key changed.
    function taskAssigneeUpdate(wid, pid, ch, s0, s1, cl) {
      return resource.data.get('picUid', null) == request.auth.uid
        && ch.hasOnly(assigneeKeys().concat(['closeRequest', 'closeRequestHistory', 'blockerResolutions']))
        && s0 in ['Planned', 'InProgress', 'Submitted']
        && request.resource.data.get('status', null) != null
        && appendOnly(ch, 'updates')
        && appendOnly(ch, 'checkIns')
        && (!cl || closeTransitionOk(wid, pid, ch, s0, s1, false, false, {}))
        && isActiveMember(wid);
    }

    // Contributor (P2.2): uid in contributorUids and not the PIC (the PIC
    // has the Assignee branch). Only keys updates/updatedAt/updatedBy/version;
    // updates is append-only. A contributor who is also PM / Sub-PM / Owner
    // passes through those broader branches instead. No extra get() (members).
    function contributorKeys() {
      return ['updates', 'updatedAt', 'updatedBy', 'version'];
    }

    function taskContributorUpdate(wid, ch) {
      return resource.data.get('contributorUids', null) is list
        && request.auth.uid in resource.data.contributorUids
        && resource.data.get('picUid', null) != request.auth.uid
        && ch.hasOnly(contributorKeys())
        && appendOnly(ch, 'updates')
        && isActiveMember(wid);
    }

    // PM / Sub-PM (non-Owner managers). Active-member check, project data,
    // programMeta entry and pm are each computed once (expression limit).
    // No self-credit: picUid may change only while the task is open (not
    // Submitted / Completed / Dropped). A status change keeps status present.
    function taskManagerUpdate(wid, pid, ch, s0, s1, cl, act, p) {
      return act && taskManagerWith(wid, pid, ch, s0, s1, cl, p,
        prgMetaOf(p, resource.data.get('programId', null)));
    }

    function taskManagerWith(wid, pid, ch, s0, s1, cl, p, m) {
      return taskManagerPm(wid, pid, ch, s0, s1, cl, p, m, isPMOrDeputyUid(m, request.auth.uid));
    }

    // pm = isPM(wid, pid, old programId) given the active-member check.
    // A PM may do everything a Sub-PM may (+ moves), so pm picks the branch.
    function taskManagerPm(wid, pid, ch, s0, s1, cl, p, m, pm) {
      return (pm ? taskPMMoveOk(wid, pid, ch, p) : taskLeadOk(wid, pid, ch, p))
        && taskDatesOk(wid, pid, ch)
        && (!ch.hasAny(['picUid']) || isOpenSt(s0))
        && (!ch.hasAny(['status']) || request.resource.data.get('status', null) != null)
        && (!cl || closeTransitionOk(wid, pid, ch, s0, s1, true, pm, m));
    }

    // ch / s0 / s1 / cl are computed once here and passed as arguments
    // (expression limit, see changedKeys).
    function taskUpdateOk(wid, pid) {
      return taskUpdateCh(wid, pid, changedKeys(),
        resource.data.get('status', 'Planned'), request.resource.data.get('status', 'Planned'));
    }

    function taskUpdateCh(wid, pid, ch, s0, s1) {
      return taskUpdateWith(wid, pid, ch, s0, s1, ch.hasAny(closeKeys()));
    }

    function taskUpdateWith(wid, pid, ch, s0, s1, cl) {
      return newEntryOk(ch, 'updates') && newEntryOk(ch, 'checkIns') && closeStampOk(ch, s1) && (
        isWsOwner(wid)
        || taskAssigneeUpdate(wid, pid, ch, s0, s1, cl)
        || taskContributorUpdate(wid, ch)
        || taskManagerUpdate(wid, pid, ch, s0, s1, cl, isActiveMember(wid), v2Project(wid, pid))
      );
    }

    match /workspaces/{wid}/projects/{pid}/tasks/{tid} {
      // get(): 3.
      allow read: if projectIsV2(wid, pid) && canReadProject(wid, pid);

      // get(): Owner 2, PM / Sub-PM 4. P3: a non-Owner creates open tasks
      // only (closing goes through the transitions above).
      allow create: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionOnCreate() && stampedByMe() && (
        isWsOwner(wid)
        || (isOpenSt(request.resource.data.get('status', 'Planned'))
          && (isPM(wid, pid, request.resource.data.get('programId', null))
            || isLead(wid, pid, request.resource.data.get('workstreamId', null)))
          && wsInProgram(wid, pid, request.resource.data.get('workstreamId', null),
                         request.resource.data.get('programId', null))
          && taskWithinNewWs(wid, pid))
      );

      // get(): Owner 2, others up to 5.
      allow update: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionBumped() && stampedByMe() && taskUpdateOk(wid, pid);

      // Ruling AF (P2.3): workspace Owner only (tasks are never hard-deleted;
      // PM / Sub-PM set Dropped). get(): 2.
      allow delete: if isSmartOSC() && projectIsV2(wid, pid) && isWsOwner(wid);
    }

    // ─────── v2: actions ───────
    // Create/update/delete: Owner, or PM / Sub-PM of the action's workstream.
    // Rules cannot iterate programMeta, so an action with workstreamId null
    // is Owner-only (documented limitation).
    // Changing workstreamId requires the manager role on both sides.
    // Action PIC (picUid == me) may update it and close it as Done, but only
    // via the actionPicKeys allow-list (P2.3), may not cancel it, and may not
    // touch a Cancelled action.
    // Every writer: an added updates entry carries authorUid == me (Ruling R).
    // All writers: version create = 1 / update = +1; updatedBy must equal
    // the caller uid on every write (Ruling I).
    // get(): create/delete = workspace, members/{me}, ws, project = 4;
    //        update = + new ws = 5; read = 3.
    // P2.4 projectIsV2 reuses the project get (Owner-only writes: 2).
    function actionManager(wid, pid, d) {
      return wsExists(wid, pid, d.get('workstreamId', null))
        && (isPM(wid, pid, v2WsData(wid, pid, d.workstreamId).get('programId', null))
          || isLead(wid, pid, d.workstreamId));
    }

    // P2.3: the PIC may only touch these keys (no title / due / pic / ws...);
    // updates is append-only for the PIC (like the task Assignee).
    function actionPicKeys() {
      // Ruling U: subtasks of their own action (no shape checks).
      return ['status', 'completedAt', 'subtasks', 'updates', 'updatedAt', 'updatedBy', 'version'];
    }

    function actionPicUpdate(wid, ch) {
      return resource.data.get('picUid', null) == request.auth.uid
        && ch.hasOnly(actionPicKeys())
        && resource.data.get('status', 'Pending') != 'Cancelled'
        && request.resource.data.get('status', 'Pending') != 'Cancelled'
        && appendOnly(ch, 'updates')
        && isActiveMember(wid);
    }

    function actionUpdateOk(wid, pid) {
      let ch = changedKeys();
      return newEntryOk(ch, 'updates') && (
        isWsOwner(wid)
        || actionPicUpdate(wid, ch)
        || (actionManager(wid, pid, resource.data)
          && (!ch.hasAny(['workstreamId']) || actionManager(wid, pid, request.resource.data)))
      );
    }

    match /workspaces/{wid}/projects/{pid}/actions/{aid} {
      // get(): 3.
      allow read: if projectIsV2(wid, pid) && canReadProject(wid, pid);

      // get(): Owner 2, manager 4.
      allow create: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionOnCreate() && stampedByMe() && (
        isWsOwner(wid)
        || actionManager(wid, pid, request.resource.data)
      );

      // get(): Owner 2, PIC 3, manager up to 5.
      allow update: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionBumped() && stampedByMe() && actionUpdateOk(wid, pid);

      // get(): Owner 2, manager 4.
      allow delete: if isSmartOSC() && projectIsV2(wid, pid) && (
        isWsOwner(wid)
        || actionManager(wid, pid, resource.data)
      );
    }

    // ─────── v2: RAID (one doc per program, P2.2 Ruling K') ───────
    // raid/{programId} = { workspaceId, projectId, programId, items,
    //   viaProgramId?, viaWorkstreamId?, updatedBy, version }.
    // Write: Owner, or PM/Deputy of viaProgramId, or Sub-PM of
    // viaWorkstreamId (a ws doc in THIS project path whose program is in
    // programMeta) = "any PM/Sub-PM of the project" without iterating a map.
    // The claim is read from the NEW data, so each writer must set its own
    // claim (a stale claim left by someone else does not help).
    // Always: programId == doc id and a key in programMeta; programId never
    // changes on update; path fields, stamping and version apply.
    // Delete: Owner only.
    // get(): create/update = workspace, project, members/{me}, ws = 4;
    //        read = 3; delete = 1 (P2.4 projectIsV2: 2; others unchanged).
    // Shared by RAID and decisions: Owner, or the claim in the NEW data
    // (viaProgramId = a program I am PM/Deputy of, viaWorkstreamId = a ws
    // in this project I lead).
    function claimWriterOk(wid, pid, p, n) {
      return isWsOwner(wid)
        || (n.get('viaProgramId', null) is string
          && n.viaProgramId in p.get('programMeta', {})
          && isPMIn(p, n.viaProgramId)
          && isActiveMember(wid))
        || isLead(wid, pid, n.get('viaWorkstreamId', null));
    }

    function raidWriterOk(wid, pid, prg) {
      let p = v2Project(wid, pid);
      let n = request.resource.data;
      return n.get('programId', null) == prg
        && prg in p.get('programMeta', {})
        && claimWriterOk(wid, pid, p, n);
    }

    match /workspaces/{wid}/projects/{pid}/raid/{programId} {
      // get(): 3.
      allow read: if projectIsV2(wid, pid) && canReadProject(wid, pid);

      // get(): up to 4 (project shared with raidWriterOk).
      allow create: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionOnCreate() && stampedByMe() && raidWriterOk(wid, pid, programId);

      // get(): up to 4.
      allow update: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionBumped() && stampedByMe()
        && request.resource.data.get('programId', null) == resource.data.get('programId', null)
        && raidWriterOk(wid, pid, programId);

      // get(): 2.
      allow delete: if isSmartOSC() && projectIsV2(wid, pid) && isWsOwner(wid);
    }

    // ─────── v2: decisions (one doc per decision, P2.3 Ruling Q) ───────
    // decisions/{decisionId} = v1 decision object + { workspaceId, projectId,
    //   order, viaProgramId?, viaWorkstreamId?, updatedBy, version }.
    // Write: same claims as RAID (claimWriterOk); no programId/doc-id rule.
    // Path fields, stamping and version apply.
    // Delete: Owner, or an active PM/Deputy of the STORED viaProgramId
    // (no new data on delete); Sub-PMs set status instead.
    // get(): create/update = workspace, project, members/{me}, ws = 4;
    //        read = 3; delete = workspace, project, members/{me} = 3.
    // P2.4 projectIsV2 reuses the project get: counts unchanged.
    match /workspaces/{wid}/projects/{pid}/decisions/{decisionId} {
      // get(): 3.
      allow read: if projectIsV2(wid, pid) && canReadProject(wid, pid);

      // get(): up to 4.
      allow create: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionOnCreate() && stampedByMe()
        && claimWriterOk(wid, pid, v2Project(wid, pid), request.resource.data);

      // get(): up to 4.
      allow update: if isSmartOSC() && projectIsV2(wid, pid) && pathFieldsOk(wid, pid)
        && versionBumped() && stampedByMe()
        && claimWriterOk(wid, pid, v2Project(wid, pid), request.resource.data);

      // get(): up to 3.
      allow delete: if isSmartOSC() && projectIsV2(wid, pid) && (
        isWsOwner(wid)
        || (resource.data.get('viaProgramId', null) is string
          && resource.data.viaProgramId in v2Project(wid, pid).get('programMeta', {})
          && isPMIn(v2Project(wid, pid), resource.data.viaProgramId)
          && isActiveMember(wid))
      );
    }

    // ─────── v2: activity (one event per doc, append-only) ───────
    // Any reader may append an event authored by themselves, stamped with
    // the server time (P2.3: createdAt == request.time, i.e. serverTimestamp()).
    // projectId/workspaceId are optional on events but must match when set.
    // get(): workspace, members/{me}, project = 3.
    match /workspaces/{wid}/projects/{pid}/activity/{eid} {
      // get(): 3 (P2.4 projectIsV2 shares the project get).
      allow read: if projectIsV2(wid, pid) && canReadProject(wid, pid);

      // get(): 3.
      allow create: if projectIsV2(wid, pid) && canReadProject(wid, pid)
        && request.resource.data.get('authorUid', null) == request.auth.uid
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('projectId', pid) == pid
        && request.resource.data.get('workspaceId', wid) == wid;

      allow update, delete: if false;
    }

    // ─────── User directory (so owners can pick teammates by email) ───────
    // Each user upserts their own entry on sign-in; everyone in the workspace
    // can read it to populate the member-picker.
    match /workspaces/main/users/{uid} {
      allow read: if isSmartOSC();
      allow write: if isSmartOSC() && request.auth.uid == uid;
    }

    // ─────── Per-user private prefs (currentProjectId, etc.) ───────
    match /users/{uid} {
      allow read, write: if isSmartOSC() && request.auth.uid == uid;
    }
  }
}
